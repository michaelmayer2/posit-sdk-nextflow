plugins {
    id 'nf-workbench@0.1.0'
}

process {
    executor = 'workbench'
}

executor {
    $workbench {
        // Required: a valid Workbench compute env/cluster name. Find valid names with:
        //   from posit.workbench.admin import Client   # or: from posit.workbench import Client, if in-session
        //   print([c["name"] for c in Client().compute_envs.list()["clusters"]])
        cluster = params.workbenchCluster ?: 'Kubernetes'

        // Optional: override if posit-workbench-nf-launcher isn't on PATH.
        launcherCli = params.launcherCli ?: 'posit-workbench-nf-launcher'
    }
}

profiles {
    // Run from inside a Positron or RStudio Pro Workbench session -- no credentials to set,
    // the launcher CLI picks up the ambient session cookie automatically.
    interactive {
    }

    // Run headlessly: either drive `nextflow run` from any host with WORKBENCH_SERVER/
    // WORKBENCH_API_KEY set, or submit the whole `nextflow run` invocation itself as a
    // Workbench Job via the Workbench API (see the repo root README).
    headless {
    }
}
